<UserControl x:Class="Ets2Trainer.App.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext: SetupViewModel -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <!-- Plugin -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Eyebrow}" Text="IN-GAME-PLUGIN" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Error}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PluginOk}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Ok}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding PluginStateText}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,14"
                                   Text="Das Plugin nutzt die offizielle SCS-Plugin-Schnittstelle: ETS2 lädt es selbst beim Start, kein Injector nötig. Beim Spielstart erscheint ein Hinweis zu SDK-Plugins – einfach mit OK bestätigen." />
                        <TextBlock Style="{StaticResource Eyebrow}" Text="SPIELORDNER" />
                        <TextBlock Text="{Binding GameDirectoryText}" FontFamily="{StaticResource Display}" FontSize="12.5" Foreground="{StaticResource TextDim}"
                                   TextWrapping="Wrap" Margin="0,0,0,16" />
                        <WrapPanel>
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding InstallCommand}" Content="Installieren / Aktualisieren" Margin="0,0,10,8" />
                            <Button Style="{StaticResource GhostButton}" Command="{Binding UninstallCommand}" Content="Entfernen" Margin="0,0,10,8" />
                            <Button Style="{StaticResource GhostButton}" Command="{Binding OpenLogCommand}" Content="Plugin-Log öffnen" Margin="0,0,10,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Safety -->
                <Border Style="{StaticResource Card}" BorderBrush="#55FFB020">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Eyebrow}" Text="WO DER TRAINER LÄUFT" />
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,8" Foreground="{StaticResource Text}"
                                   Text="✔  Singleplayer  ·  ✔  offizieller SCS-Konvoi (Live-Funktionen)  ·  ✖  TruckersMP" />
                        <TextBlock Style="{StaticResource BodyText}"
                                   Text="Wird TruckersMP erkannt, sperrt das Plugin alle Schreibzugriffe automatisch. Im Konvoi am besten nur mit Freunden nutzen, die Bescheid wissen. Saves vorher sichern – der Trainer legt bei jedem Überschreiben ein Backup an." />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <!-- Keys -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Eyebrow}" Text="MENÜ EIN/AUS" />
                        <ComboBox ItemsSource="{Binding MenuKeys}" SelectedItem="{Binding MenuKey}" Margin="0,0,0,16" AutomationProperties.Name="Menü-Taste" />
                        <TextBlock Style="{StaticResource Eyebrow}" Text="NITRO-TASTE (HALTEN)" />
                        <ComboBox ItemsSource="{Binding NitroKeys}" SelectedItem="{Binding NitroKey}" Margin="0,0,0,18" AutomationProperties.Name="Nitro-Taste" />
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AlwaysOnTop}">
                            <TextBlock Text="Immer im Vordergrund (über dem Spiel)" FontFamily="{StaticResource Body}" FontSize="13" Foreground="{StaticResource Text}" />
                        </CheckBox>
                        <TextBlock Style="{StaticResource BodyText}" FontSize="12" Margin="0,10,0,0"
                                   Text="Tipp: ETS2 im Modus „Vollbild (randlos)“ oder Fenster spielen, dann liegt der Trainer sauber über dem Spiel." />
                    </StackPanel>
                </Border>

                <!-- Folders -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Eyebrow}" Text="ORDNER" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding OpenBackupsCommand}" Content="Backups öffnen" HorizontalAlignment="Left" Margin="0,0,0,8" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding OpenModFolderCommand}" Content="Mod-Ordner öffnen" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
