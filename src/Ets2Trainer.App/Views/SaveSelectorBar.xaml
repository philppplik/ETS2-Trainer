<UserControl x:Class="Ets2Trainer.App.Views.SaveSelectorBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext: SaveEditorViewModel -->
    <Border Style="{StaticResource Card}" Padding="18,14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Style="{StaticResource Eyebrow}" Text="PROFIL" />
            <ComboBox Grid.Row="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                      AutomationProperties.Name="Profil" />

            <TextBlock Grid.Column="2" Style="{StaticResource Eyebrow}" Text="SPIELSTAND" />
            <ComboBox Grid.Column="2" Grid.Row="1" ItemsSource="{Binding Slots}" SelectedItem="{Binding SelectedSlot}"
                      AutomationProperties.Name="Spielstand" />

            <StackPanel Grid.Column="4" Grid.Row="1" Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" ToolTip="Liste neu einlesen" Padding="12,9">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="14" />
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding LoadCommand}" Content="Laden" MinWidth="110" />
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.ColumnSpan="5" Orientation="Horizontal" Margin="0,12,0,0">
                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource TextMute}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource Ok}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding LoadedTitle}" FontFamily="{StaticResource Display}" FontSize="13" Foreground="{StaticResource TextDim}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
