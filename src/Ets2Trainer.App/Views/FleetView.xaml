<UserControl x:Class="Ets2Trainer.App.Views.FleetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Ets2Trainer.App.Views">
    <!-- DataContext: SaveEditorViewModel -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <views:SaveSelectorBar />

        <!-- Empty state -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440"
                    Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
            <TextBlock Text="&#xE804;" FontFamily="{StaticResource Icons}" FontSize="40" Foreground="{StaticResource Amber}" HorizontalAlignment="Center" />
            <TextBlock Style="{StaticResource CardTitle}" Text="Garagen, Fahrer und Trucks" TextAlignment="Center" Margin="0,14,0,8" />
            <TextBlock Style="{StaticResource BodyText}" TextAlignment="Center"
                       Text="Lade oben einen Spielstand. Danach kannst du alle Garagen kaufen und ausbauen, deine Fahrer maximieren und die ganze Flotte reparieren." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16" Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Action strip: three actions, garages lead -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Background="{StaticResource HeroGlow}">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" Command="{Binding BuyGaragesCommand}"
                                HorizontalAlignment="Left" Margin="0,14,0,0" Content="Alle kaufen &amp; auf groß ausbauen" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource Eyebrow}" Text="GARAGEN" />
                            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding GarageSummary}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" Text="Jede Garage bekommt 5 Stellplätze für Trucks und Fahrer." />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource GhostButton}" Command="{Binding MaxDriversCommand}"
                                HorizontalAlignment="Left" Margin="0,14,0,0" Content="Alle Fahrer maximieren" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource Eyebrow}" Text="MITARBEITER" />
                            <TextBlock Style="{StaticResource BodyText}" Text="ADR + alle Skills auf 6, mindestens 5 Mio. XP für jeden angestellten Fahrer." />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource GhostButton}" Command="{Binding RepairFleetCommand}"
                                HorizontalAlignment="Left" Margin="0,14,0,0" Content="Flotte reparieren &amp; tanken" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource Eyebrow}" Text="FUHRPARK" />
                            <TextBlock Style="{StaticResource BodyText}" Text="Setzt Verschleiß aller Trucks und Auflieger auf 0 % und füllt alle Tanks." />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Lists -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="16,14">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Eyebrow}" Text="TRUCKS  ·  DEIN TRUCK ZUERST" />
                        <DataGrid ItemsSource="{Binding Trucks}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="MODELL" Binding="{Binding Model}" Width="1.3*" />
                                <DataGridTextColumn Header="KENNZ." Binding="{Binding Plate}" Width="*" />
                                <DataGridTextColumn Header="MOTOR" Binding="{Binding Engine}" Width="*" />
                                <DataGridTextColumn Header="VERSCHL." Binding="{Binding Wear}" Width="0.8*" />
                                <DataGridTextColumn Header="TANK" Binding="{Binding Fuel}" Width="0.6*" />
                                <DataGridTextColumn Header="KM" Binding="{Binding Odometer}" Width="0.9*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Eyebrow}" Text="FAHRER" />
                        <DataGrid ItemsSource="{Binding Drivers}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="0.9*" />
                                <DataGridTextColumn Header="HEIMAT" Binding="{Binding Hometown}" Width="0.9*" />
                                <DataGridTextColumn Header="XP" Binding="{Binding Xp}" Width="*" />
                                <DataGridTextColumn Header="SKILLS" Binding="{Binding Skills}" Width="1.3*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <views:SaveActionBar Grid.Row="2" Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
