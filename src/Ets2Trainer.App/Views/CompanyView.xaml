<UserControl x:Class="Ets2Trainer.App.Views.CompanyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Ets2Trainer.App.Views">
    <!-- DataContext: SaveEditorViewModel -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <views:SaveSelectorBar />

        <!-- Empty state -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440"
                    Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
            <TextBlock Text="&#xE825;" FontFamily="{StaticResource Icons}" FontSize="40" Foreground="{StaticResource Amber}" HorizontalAlignment="Center" />
            <TextBlock Style="{StaticResource CardTitle}" Text="Wähle oben einen Spielstand und klicke „Laden“" TextAlignment="Center" Margin="0,14,0,8" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource BodyText}" TextAlignment="Center"
                       Text="Geld, Erfahrung und Skills werden im Spielstand geändert. Standardmäßig entsteht ein neuer Stand „[Trainer] …“ – dein Original bleibt unberührt." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,16" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <!-- Money -->
                    <Border Style="{StaticResource Card}" Background="{StaticResource HeroGlow}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Eyebrow}" Text="FIRMENKONTO" />
                            <TextBlock Style="{StaticResource Numeric}" Text="{Binding MoneyText}" FontSize="46" Foreground="{StaticResource Amber}" Margin="0,0,0,14" />
                            <TextBox Text="{Binding Money, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Kontostand in Euro" Margin="0,0,0,12" />
                            <WrapPanel>
                                <Button Style="{StaticResource ChipButton}" Content="+ 1 Mio." Command="{Binding AddMoneyCommand}" CommandParameter="1000000" />
                                <Button Style="{StaticResource ChipButton}" Content="+ 10 Mio." Command="{Binding AddMoneyCommand}" CommandParameter="10000000" />
                                <Button Style="{StaticResource ChipButton}" Content="+ 100 Mio." Command="{Binding AddMoneyCommand}" CommandParameter="100000000" />
                                <Button Style="{StaticResource ChipButton}" Content="+ 1 Mrd." Command="{Binding AddMoneyCommand}" CommandParameter="1000000000" />
                                <Button Style="{StaticResource ChipButton}" Content="Auf 0 setzen" Command="{Binding SetMoneyCommand}" CommandParameter="0" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Experience -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Eyebrow}" Text="ERFAHRUNG" />
                            <TextBlock Style="{StaticResource Numeric}" Text="{Binding ExperienceText}" FontSize="30" Margin="0,0,0,12" />
                            <TextBox Text="{Binding Experience, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Erfahrungspunkte" Margin="0,0,0,12" />
                            <WrapPanel>
                                <Button Style="{StaticResource ChipButton}" Content="+ 100.000" Command="{Binding AddXpCommand}" CommandParameter="100000" />
                                <Button Style="{StaticResource ChipButton}" Content="+ 1 Mio." Command="{Binding AddXpCommand}" CommandParameter="1000000" />
                                <Button Style="{StaticResource ChipButton}" Content="+ 10 Mio." Command="{Binding AddXpCommand}" CommandParameter="10000000" />
                                <Button Style="{StaticResource ChipButton}" Content="Maximum" Command="{Binding SetXpCommand}" CommandParameter="4294967295" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource BodyText}" FontSize="12" Margin="0,6,0,0"
                                       Text="Das Level berechnet das Spiel aus den Erfahrungspunkten." />
                        </StackPanel>
                    </Border>

                    <!-- Extras -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Eyebrow}" Text="EXTRAS" />
                            <TextBlock Style="{StaticResource BodyText}" Text="{Binding FleetSummary}" Margin="0,0,0,12" />
                            <WrapPanel>
                                <Button Style="{StaticResource GhostButton}" Command="{Binding ClearLoansCommand}" Margin="0,0,10,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C7;" FontFamily="{StaticResource Icons}" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Alle Kredite tilgen" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Command="{Binding VisitCitiesCommand}" Margin="0,0,10,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE707;" FontFamily="{StaticResource Icons}" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Alle Städte besuchen" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Skills -->
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <Button DockPanel.Dock="Right" Style="{StaticResource ChipButton}" Margin="0" Content="Alles maximieren" Command="{Binding MaxSkillsCommand}" />
                            <TextBlock Style="{StaticResource CardTitle}" Text="Fähigkeiten" VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock Style="{StaticResource Eyebrow}" Text="ADR-GEFAHRGUTKLASSEN" />
                        <ItemsControl ItemsSource="{Binding Adr}" Margin="0,4,0,14">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource Check}" Content="{Binding Label}" IsChecked="{Binding IsChecked}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Skills}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" FontFamily="{StaticResource Body}" FontSize="13" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="1"
                                                Value="{Binding Value}" AutomationProperties.Name="{Binding Label}" />
                                        <TextBlock Grid.Column="2" FontFamily="{StaticResource Display}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Amber}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Run Text="{Binding Value, Mode=OneWay}" /><Run Text="/6" Foreground="{StaticResource TextMute}" />
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <views:SaveActionBar Grid.Row="2" Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
