<UserControl x:Class="Ets2Trainer.App.Views.WorkshopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Ets2Trainer.App.Views">
    <!-- DataContext: MainViewModel (uses .Workshop and .Save) -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid DataContext="{Binding Workshop}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.45*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Builder -->
            <Border Style="{StaticResource Card}" Padding="24,22">
                <Grid>
                    <!-- Loading archives -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <TextBlock Text="&#xE90F;" FontFamily="{StaticResource Icons}" FontSize="40" Foreground="{StaticResource Amber}" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource CardTitle}" Text="Motor-Werkstatt" HorizontalAlignment="Center" Margin="0,14,0,8" />
                        <TextBlock Style="{StaticResource BodyText}" TextAlignment="Center" MaxWidth="380" Margin="0,0,0,16"
                                   Text="Liest die Original-Motoren deiner Trucks aus den Spielarchiven – Sound, Kennlinie und Emblem bleiben erhalten." />
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding InitializeCommand}" Content="Spielarchive einlesen" HorizontalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Eyebrow}" Text="1  ·  TRUCK-MODELL" />
                        <ComboBox ItemsSource="{Binding TruckModels}" SelectedItem="{Binding SelectedTruck}" Margin="0,0,0,18" AutomationProperties.Name="Truck-Modell" />

                        <TextBlock Style="{StaticResource Eyebrow}" Text="2  ·  BASIS-MOTOR  (SOUND &amp; KENNLINIE)" />
                        <ComboBox ItemsSource="{Binding Engines}" SelectedItem="{Binding SelectedEngine}" Margin="0,0,0,22" AutomationProperties.Name="Basis-Motor" />

                        <TextBlock Style="{StaticResource Eyebrow}" Text="3  ·  LEISTUNG" />
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10">
                                <Button Style="{StaticResource ChipButton}" Content="1.000" Command="{Binding PresetCommand}" CommandParameter="1000" />
                                <Button Style="{StaticResource ChipButton}" Content="2.000" Command="{Binding PresetCommand}" CommandParameter="2000" />
                                <Button Style="{StaticResource ChipButton}" Content="5.000" Command="{Binding PresetCommand}" CommandParameter="5000" />
                                <Button Style="{StaticResource ChipButton}" Content="10.000" Command="{Binding PresetCommand}" CommandParameter="10000" Margin="0,0,0,6" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Numeric}" Text="{Binding TargetHpText}" FontSize="58" Foreground="{StaticResource Amber}" Margin="-2,-6,0,0" />
                        </DockPanel>
                        <Slider Minimum="100" Maximum="10000" SmallChange="10" LargeChange="100" Value="{Binding TargetHp}" Margin="0,6,0,8"
                                AutomationProperties.Name="Ziel-PS" />
                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding TorquePreview}" Margin="0,0,0,22" />

                        <WrapPanel>
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding GenerateAndInstallCommand}" Margin="0,0,10,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Erzeugen &amp; in meinen Truck einbauen" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Command="{Binding GenerateCommand}" Content="Nur erzeugen (im Spiel kaufen)" Margin="0,0,10,8" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                   Text="„Einbauen“ braucht einen geladenen Spielstand (Tab FIRMA) und wird mit „Speichern“ unten übernommen." />

                        <!-- Before / after -->
                        <Border Style="{StaticResource Well}" Margin="0,24,0,0" Padding="18,16">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Eyebrow}" Text="VORHER  →  NACHHER" />
                                <DockPanel Margin="0,4,0,6">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding BaseHpText}" FontFamily="{StaticResource Display}" FontSize="13" Foreground="{StaticResource TextDim}" />
                                    <TextBlock Text="Original" FontFamily="{StaticResource Body}" FontSize="13" Foreground="{StaticResource TextDim}" />
                                </DockPanel>
                                <ProgressBar Style="{StaticResource Gauge}" Height="10" Foreground="{StaticResource TextMute}" Value="{Binding BaseRatio, Mode=OneWay}" Margin="0,0,0,14" />
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding NewHpText}" FontFamily="{StaticResource Display}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Amber}" />
                                    <TextBlock Text="Trainer-Motor" FontFamily="{StaticResource Body}" FontSize="13" Foreground="{StaticResource Text}" />
                                </DockPanel>
                                <ProgressBar Style="{StaticResource Gauge}" Height="10" Value="{Binding NewRatio, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Guide + mod state -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="So kommt der Motor ins Spiel" Margin="0,0,0,14" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="1" Style="{StaticResource Numeric}" FontSize="18" Foreground="{StaticResource Amber}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource BodyText}" Text="Motor erzeugen – er landet in der Mod „ETS2 Trainer - Motoren“." />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="2" Style="{StaticResource Numeric}" FontSize="18" Foreground="{StaticResource Amber}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource BodyText}" Text="Mod aktivieren (Button unten, Spiel geschlossen) oder im Mod-Manager einschalten." />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="3" Style="{StaticResource Numeric}" FontSize="18" Foreground="{StaticResource Amber}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource BodyText}" Text="Eingebaut: „[Trainer]“-Spielstand laden. Sonst: in der Werkstatt für 1 € kaufen." />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Eyebrow}" Text="MOD-STATUS" />
                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding ModState}" Margin="0,0,0,12" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding ActivateModCommand}" Content="Mod im Profil aktivieren" HorizontalAlignment="Left" Margin="0,0,0,14" />
                        <TextBlock Style="{StaticResource Eyebrow}" Text="ERZEUGTE MOTOREN" />
                        <ItemsControl ItemsSource="{Binding GeneratedEngines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="{StaticResource Display}" FontSize="12.5" Foreground="{StaticResource TextDim}" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <views:SaveActionBar Grid.Row="1" Margin="0,16,0,0" DataContext="{Binding Save}"
                             Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
