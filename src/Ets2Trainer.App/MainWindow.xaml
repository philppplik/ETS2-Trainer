<Window x:Class="Ets2Trainer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Ets2Trainer.App.Views"
        Title="ETS2 Trainer" Width="1240" Height="800" MinWidth="1080" MinHeight="700"
        Background="{StaticResource Bg0}" Foreground="{StaticResource Text}"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid Background="{StaticResource Bg0}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="92" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation rail -->
        <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False">
                <Border DockPanel.Dock="Top" Width="46" Height="46" Margin="0,16,0,22" CornerRadius="12" Background="{StaticResource Amber}">
                    <TextBlock Text="E2T" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="16" Foreground="#1A1204"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavItem}" Tag="&#xE945;" Content="LIVE"
                             IsChecked="{Binding CurrentSection, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=Live}"
                             Command="{Binding NavigateCommand}" CommandParameter="Live" />
                <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavItem}" Tag="&#xE707;" Content="TELEPORT"
                             IsChecked="{Binding CurrentSection, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=Teleport}"
                             Command="{Binding NavigateCommand}" CommandParameter="Teleport" />
                <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavItem}" Tag="&#xE76E;" Content="SPASS"
                             IsChecked="{Binding CurrentSection, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=Fun}"
                             Command="{Binding NavigateCommand}" CommandParameter="Fun" />
                <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavItem}" Tag="&#xE825;" Content="FIRMA"
                             IsChecked="{Binding CurrentSection, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=Company}"
                             Command="{Binding NavigateCommand}" CommandParameter="Company" />
                <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavItem}" Tag="&#xE804;" Content="FLOTTE"
                             IsChecked="{Binding CurrentSection, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=Fleet}"
                             Command="{Binding NavigateCommand}" CommandParameter="Fleet" />
                <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavItem}" Tag="&#xE90F;" Content="WERKSTATT"
                             IsChecked="{Binding CurrentSection, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=Workshop}"
                             Command="{Binding NavigateCommand}" CommandParameter="Workshop" />
                <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavItem}" Tag="&#xE713;" Content="SETUP"
                             IsChecked="{Binding CurrentSection, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=Setup}"
                             Command="{Binding NavigateCommand}" CommandParameter="Setup" />

                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,18" HorizontalAlignment="Center">
                    <Border CornerRadius="6" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="8,3" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding MenuHotkeyText}" FontFamily="{StaticResource Display}" FontSize="12" Foreground="{StaticResource TextDim}" />
                    </Border>
                    <TextBlock Text="ein/aus" Margin="0,4,0,0" FontSize="10.5" Foreground="{StaticResource TextMute}" HorizontalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <DockPanel Margin="28,0,8,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="999" Padding="12,5" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource Bg2}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Live.IsLive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource OkWash}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Live.IsBlocked}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ErrorWash}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource TextMute}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Live.IsLive}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Ok}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Live.IsBlocked}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Error}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding Live.ConnectionText}" FontFamily="{StaticResource Display}" FontSize="12.5" Foreground="{StaticResource Text}" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimieren" />
                    <Button Style="{StaticResource WindowButton}" Content="&#xE8BB;" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Schließen" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ETS2 TRAINER" FontFamily="{StaticResource Display}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                    <TextBlock Text="Singleplayer &amp; SCS-Konvoi" Margin="14,1,0,0" FontFamily="{StaticResource Body}" FontSize="12" Foreground="{StaticResource TextMute}" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>

            <!-- Sections (kept alive so state survives navigation) -->
            <Grid Grid.Row="1" Margin="28,4,28,24">
                <views:LiveView DataContext="{Binding Live}"
                                Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumMatch}, ConverterParameter=Live}" />
                <views:TeleportView DataContext="{Binding Teleport}"
                                    Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumMatch}, ConverterParameter=Teleport}" />
                <views:FunView DataContext="{Binding Fun}"
                               Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumMatch}, ConverterParameter=Fun}" />
                <views:CompanyView DataContext="{Binding Save}"
                                   Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumMatch}, ConverterParameter=Company}" />
                <views:FleetView DataContext="{Binding Save}"
                                 Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumMatch}, ConverterParameter=Fleet}" />
                <views:WorkshopView DataContext="{Binding}"
                                    Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumMatch}, ConverterParameter=Workshop}" />
                <views:SetupView DataContext="{Binding Setup}"
                                 Visibility="{Binding DataContext.CurrentSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumMatch}, ConverterParameter=Setup}" />
            </Grid>

            <!-- Toast -->
            <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,108" MaxWidth="760"
                    CornerRadius="10" Padding="16,11" BorderThickness="1"
                    Visibility="{Binding HasToast, Converter={StaticResource BoolToVisibility}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource Bg3}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Amber}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ToastIsError}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Error}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.55" Color="Black" />
                </Border.Effect>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource WindowButton}" Width="28" Height="24" Margin="12,0,0,0"
                            Content="&#xE8BB;" Command="{Binding DismissToastCommand}" />
                    <TextBlock Text="{Binding ToastText}" TextWrapping="Wrap" VerticalAlignment="Center"
                               FontFamily="{StaticResource Body}" FontSize="13" Foreground="{StaticResource Text}" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
